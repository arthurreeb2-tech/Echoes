<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>io.echoes.app</string>
  <key>CFBundleName</key><string>Echoes</string>
  <key>CFBundleDisplayName</key><string>Echoes</string>
  <key>CFBundleExecutable</key><string>Echoes</string>
  <key>CFBundleIconFile</key><string>Echoes</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>__VERSION__</string>
  <key>CFBundleVersion</key><string>__VERSION__</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <!-- macOS 15+ : sans ces clés, l'icône lancée à l'ouverture de session ne peut pas joindre les autres machines. -->
  <key>NSLocalNetworkUsageDescription</key><string>Echoes trouve tes autres machines et leur confie les commandes à exécuter.</string>
  <key>NSBonjourServices</key><array><string>_echoes._tcp</string></array>
  <!-- Pas d'icône dans le Dock : l'app ne fait qu'ouvrir le tableau de bord. -->
  <key>LSUIElement</key><true/>
</dict>
</plist>

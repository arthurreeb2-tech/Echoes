#!/bin/sh
# Exécuté par l'installateur macOS (en root) : installe Echoes pour la personne connectée.
user=$(stat -f%Su /dev/console)
if [ -z "$user" ] || [ "$user" = "root" ] || [ "$user" = "_mbsetupuser" ]; then exit 0; fi
uid=$(id -u "$user")
launchctl asuser "$uid" sudo -u "$user" -H "/Applications/Echoes.app/Contents/MacOS/Echoes" install --open >> /tmp/echoes-install.log 2>&1 || true
exit 0
